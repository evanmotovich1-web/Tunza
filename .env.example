# Copy to .env.local (gitignored). Every service is optional — without a key
# the matching route answers 503 and the app degrades by design:
# voice falls back to on-device speech recognition, then to typing;
# the Nearby view falls back to the demo facility list.

# OpenAI Whisper, used by /api/transcribe for voice input.
OPENAI_API_KEY=

# Google Places (New), used by /api/facilities for the Nearby view.
GOOGLE_PLACES_API_KEY=

# Health-worker access codes, checked by /api/access. Until both are set,
# the well-known demo codes CHP-DEMO and FACILITY-DEMO work (and the app
# says so on the sign-in screen).
CHP_ACCESS_CODE=
FACILITY_ACCESS_CODE=
